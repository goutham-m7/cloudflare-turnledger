  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.2",
    "agents": "0.33.0",
    "ai": "7.0.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.161.0",
    "ws": "8.18.3"
  }
}
